<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WashTrack.MVVM.ViewModels"
             x:Class="WashTrack.MVVM.Views.CustomersPage"
             x:DataType="vm:CustomersViewModel"
             Title="Customers">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Search + Active/Inactive toggle -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="16,8">
            <SearchBar Grid.Column="0"
                       Placeholder="Search customers..."
                       Text="{Binding SearchText}" />
            <Button Grid.Column="1"
                    Text="{Binding ToggleButtonText}"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="40"
                    Padding="12,0"
                    FontSize="12"
                    Margin="8,0,0,0"
                    Command="{Binding ToggleInactiveCommand}" />
        </Grid>

        <!-- Active-orders filter toggle: independent from Active/Inactive -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="16,0,16,8"
              IsVisible="{Binding ShowingInactive, Converter={StaticResource InverseBoolConverter}}">
            <Button Grid.Column="1"
                    Text="{Binding OrdersToggleButtonText}"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="36"
                    Padding="12,0"
                    FontSize="12"
                    HorizontalOptions="End"
                    Command="{Binding ToggleActiveOrdersOnlyCommand}" />
        </Grid>

        <!-- Inactive Banner -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowingInactive}"
                BackgroundColor="#FFF3CD"
                Stroke="{StaticResource WarningColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="12,8"
                Margin="16,0">
            <Label Text="Showing inactive customers. Restore or permanently delete them here."
                   FontSize="12"
                   TextColor="#856404" />
        </Border>

        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding CustomerOrders}"
                        IsVisible="{Binding IsLoading,
                            Converter={StaticResource InverseBoolConverter}}"
                        Margin="16,0,16,16">

            <CollectionView.EmptyView>
                <Label Text="No customers here."
                       Style="{StaticResource EmptyStateLabel}"
                       Margin="0,60,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomerWithOrders">
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,4">
                        <StackLayout Spacing="8">

                            <!-- Customer Header: avatar + name/contact only.
                                 Buttons live in their own full-width row below,
                                 so a long name never gets squeezed by them. -->
                            <Grid ColumnDefinitions="Auto,*">

                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource AccentColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24"
                                        HeightRequest="48"
                                        WidthRequest="48"
                                        Margin="0,0,12,0">
                                    <Image Source="{StaticResource PersonIcon}"
                                           WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <StackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="2">
                                    <Label Text="{Binding Customer.Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimaryColor}" />
                                    <Label Text="{Binding Customer.ContactNumber}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                    <Border IsVisible="{Binding HasPendingPayment}"
                                            BackgroundColor="{StaticResource WarningColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="8,2"
                                            HorizontalOptions="Start"
                                            Margin="0,2,0,0">
                                        <Label Text="₱ Pending Payment"
                                               TextColor="{StaticResource TextLightColor}"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>
                                </StackLayout>

                            </Grid>

                            <!-- Active Customer Buttons -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding Customer.IsActive}">

                                <Button Grid.Column="0"
                                        Text="Edit"
                                        Style="{StaticResource AccentButton}"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        FontSize="12"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, Path=EditCustomerCommand}"
                                        CommandParameter="{Binding Customer}" />

                                <Button Grid.Column="1"
                                        Text="Deactivate"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        FontSize="12"
                                        IsVisible="{Binding CanDelete}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, Path=DeactivateCustomerCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <!-- Inactive Customer Buttons -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding Customer.IsActive,
                                      Converter={StaticResource InverseBoolConverter}}">

                                <Button Grid.Column="0"
                                        Text="Restore"
                                        ImageSource="{StaticResource RestoreIcon}"
                                        ContentLayout="Left,4"
                                        Style="{StaticResource AccentButton}"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        FontSize="12"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, Path=RestoreCustomerCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="Delete"
                                        ImageSource="{StaticResource TrashIcon}"
                                        ContentLayout="Left,4"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        FontSize="12"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, Path=PermanentDeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <!-- Active orders: read-only count only. Payment and
                                 completion happen exclusively on the Transactions
                                 page — this card never actions an order. -->
                            <Label Text="{Binding ActiveOrders.Count, StringFormat='{0} active order(s)'}"
                                   Style="{StaticResource MutedLabelStyle}"
                                   IsVisible="{Binding HasActiveOrders}"
                                   FontSize="12" />

                            <Label Text="No active orders"
                                   Style="{StaticResource MutedLabelStyle}"
                                   IsVisible="{Binding HasActiveOrders,
                                       Converter={StaticResource InverseBoolConverter}}"
                                   FontSize="12" />

                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>