<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WashTrack.MVVM.ViewModels"
             xmlns:models="clr-namespace:WashTrack.Models"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="WashTrack.MVVM.Views.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="Transactions">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ New"
                     Command="{Binding AddTransactionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- Header + tab toggle -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="16,8">
            <Label Grid.Column="0"
                   Text="Manage laundry orders"
                   Style="{StaticResource MutedLabelStyle}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="{Binding ToggleButtonText}"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="40"
                    Padding="12,0"
                    FontSize="12"
                    Command="{Binding ToggleCompletedCommand}" />
        </Grid>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Transactions}"
                        IsVisible="{Binding IsLoading,
                            Converter={StaticResource InverseBoolConverter}}"
                        Margin="16">

            <CollectionView.EmptyView>
                <Label Text="No transactions yet. Tap + New to record one."
                       Style="{StaticResource EmptyStateLabel}"
                       Margin="0,60,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <!-- Flattened card: one Grid, no nested StackLayouts -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,4">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto">

                            <!-- Row 0: customer name + total (tap to open) -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=ViewTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Customer.Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimaryColor}" />
                                <Label Text="{Binding Items.Count, StringFormat='{0} item(s)'}"
                                       Style="{StaticResource MutedLabelStyle}" />
                            </VerticalStackLayout>

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding TotalCost, StringFormat='₱{0:F2}'}"
                                   Style="{StaticResource AccentLabelStyle}"
                                   VerticalOptions="Start" />

                            <!-- Row 1: date + completed pill -->
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}"
                                   Style="{StaticResource MutedLabelStyle}"
                                   Margin="0,4,0,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=ViewTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Border Grid.Row="1" Grid.Column="1"
                                    HorizontalOptions="End"
                                    Style="{StaticResource PillSuccess}"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding Status, Converter={StaticResource IsCompletedConverter}}">
                                <Label Text="Completed"
                                       Style="{StaticResource PillLabelStyle}" />
                            </Border>

                            <!-- Row 2: tap hint -->
                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                   Style="{StaticResource MutedLabelStyle}"
                                   FontSize="11"
                                   FontAttributes="Italic"
                                   Margin="0,4,0,0"
                                   Text="Tap to view receipt">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=ViewTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                        <Setter Property="Text" Value="Tap to edit" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Row 3: payment + wash pills (pending only) -->
                            <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2"
                                                   Spacing="8"
                                                   Margin="0,8,0,0"
                                                   IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}">

                                <!-- Not paid yet: tappable, opens collect payment -->
                                <Border Style="{StaticResource PillWarning}"
                                        IsVisible="{Binding IsPaid, Converter={StaticResource InverseBoolConverter}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=CollectPaymentCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Pending payment" Style="{StaticResource PillLabelStyle}" />
                                </Border>

                                <!-- Paid: display only, no longer tappable -->
                                <Border Style="{StaticResource PillSuccess}"
                                        IsVisible="{Binding IsPaid}">
                                    <Label Text="Paid" Style="{StaticResource PillLabelStyle}" />
                                </Border>

                                <!-- Wash status: tappable, moves forward only -->
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="12,4"
                                        BackgroundColor="{StaticResource BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=OpenWashStatusCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding WashStatus}" Value="Washing">
                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding WashStatus}" Value="Washed">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding WashStatus, StringFormat='{0} ›'}"
                                           Style="{StaticResource PillLabelStyle}" />
                                </Border>

                            </HorizontalStackLayout>

                            <!-- Row 4: Complete + Delete (pending only) -->
                            <Grid Grid.Row="4" Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8"
                                  Margin="0,8,0,0"
                                  IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}">

                                <!-- Gray until paid AND washed, then turns green -->
                                <Button Grid.Column="0"
                                        Text="Complete"
                                        Style="{StaticResource CompleteButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=CompleteOrderCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <MultiTrigger TargetType="Button">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsPaid}">
                                                    <BindingCondition.Value>
                                                        <sys:Boolean>True</sys:Boolean>
                                                    </BindingCondition.Value>
                                                </BindingCondition>
                                                <BindingCondition Binding="{Binding WashStatus}" Value="Washed" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                                            <Setter Property="TextColor" Value="{StaticResource TextLightColor}" />
                                        </MultiTrigger>
                                    </Button.Triggers>
                                </Button>

                                <Button Grid.Column="1"
                                        Text="Delete"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="38"
                                        FontSize="13"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>