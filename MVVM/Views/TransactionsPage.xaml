<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WashTrack.MVVM.ViewModels"
             xmlns:models="clr-namespace:WashTrack.Models"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="WashTrack.MVVM.Views.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="Transactions">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ New"
                     Command="{Binding AddTransactionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- Header + tab toggle -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="16,8">
            <Label Grid.Column="0"
                   Text="Manage laundry orders"
                   Style="{StaticResource MutedLabelStyle}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="{Binding ToggleButtonText}"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="40"
                    Padding="12,0"
                    FontSize="12"
                    Command="{Binding ToggleCompletedCommand}" />
        </Grid>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Transactions}"
                        IsVisible="{Binding IsLoading,
                            Converter={StaticResource InverseBoolConverter}}"
                        Margin="16">

            <CollectionView.EmptyView>
                <Label Text="No transactions yet. Tap + New to record one."
                       Style="{StaticResource EmptyStateLabel}"
                       Margin="0,60,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <!-- Flattened card: one Grid, no nested StackLayouts -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,4">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto,Auto">

                            <!-- Row 0: customer name + total + Edit/View Details button.
                                 Card is no longer tappable — this button is the only
                                 way in, so the affordance is explicit. -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="{Binding Customer.Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimaryColor}" />
                                <Label Text="{Binding Items.Count, StringFormat='{0} item(s)'}"
                                       Style="{StaticResource MutedLabelStyle}" />
                            </VerticalStackLayout>

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding TotalCost, StringFormat='₱{0:F2}'}"
                                   Style="{StaticResource AccentLabelStyle}"
                                   VerticalOptions="Start"
                                   Margin="0,0,4,0" />

                            <!-- Custom small button: MAUI Button.ImageSource has no
                                 per-instance size control, and at this compact 30px
                                 height the icon rendered too large. Composing it by
                                 hand lets the icon stay 12x12, matching pill sizing. -->
                            <Border Grid.Row="0" Grid.Column="2"
                                    WidthRequest="100"
                                    HeightRequest="30"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource PrimaryColor}"
                                    StrokeThickness="1"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Start"
                                    IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=ViewTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="{StaticResource EditIcon}"
                                           WidthRequest="12" HeightRequest="12"
                                           VerticalOptions="Center" />
                                    <Label Text="Edit"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryColor}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2"
                                    WidthRequest="100"
                                    HeightRequest="30"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource PrimaryColor}"
                                    StrokeThickness="1"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Start"
                                    IsVisible="{Binding Status, Converter={StaticResource IsCompletedConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=ViewTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="{StaticResource EyeIcon}"
                                           WidthRequest="12" HeightRequest="12"
                                           VerticalOptions="Center" />
                                    <Label Text="View Details"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryColor}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Row 1: date + completed pill -->
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}"
                                   Style="{StaticResource MutedLabelStyle}"
                                   Margin="0,4,0,0" />

                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                    HorizontalOptions="End"
                                    Style="{StaticResource PillSuccess}"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding Status, Converter={StaticResource IsCompletedConverter}}">
                                <HorizontalStackLayout Spacing="4">
                                    <Image Source="{StaticResource CheckmarkIcon}"
                                           WidthRequest="12" HeightRequest="12"
                                           VerticalOptions="Center" />
                                    <Label Text="Completed"
                                           Style="{StaticResource PillLabelStyle}" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Row 2: payment + wash pills (pending only) -->
                            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="3"
                                                   Spacing="8"
                                                   Margin="0,8,0,0"
                                                   IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}">

                                <!-- Not paid yet: tappable, opens collect payment.
                                     Only this pill can ever take payment. -->
                                <Border Style="{StaticResource PillWarning}"
                                        IsVisible="{Binding IsPaid, Converter={StaticResource InverseBoolConverter}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=CollectPaymentCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="{StaticResource PendingIcon}"
                                               WidthRequest="12" HeightRequest="12"
                                               VerticalOptions="Center" />
                                        <Label Text="Pending payment" Style="{StaticResource PillLabelStyle}" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Paid: display only, no longer tappable -->
                                <Border Style="{StaticResource PillSuccess}"
                                        IsVisible="{Binding IsPaid}">
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="{StaticResource CheckmarkIcon}"
                                               WidthRequest="12" HeightRequest="12"
                                               VerticalOptions="Center" />
                                        <Label Text="Paid" Style="{StaticResource PillLabelStyle}" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Wash status: tappable, moves forward only -->
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="12,4"
                                        BackgroundColor="{StaticResource BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=OpenWashStatusCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding WashStatus}" Value="Washing">
                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding WashStatus}" Value="Washed">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="{StaticResource WashingIcon}"
                                               WidthRequest="12" HeightRequest="12"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding WashStatus, StringFormat='{0} ›'}"
                                               Style="{StaticResource PillLabelStyle}" />
                                    </HorizontalStackLayout>
                                </Border>

                            </HorizontalStackLayout>

                            <!-- Row 3: Complete + Delete (pending only) -->
                            <Grid Grid.Row="3" Grid.ColumnSpan="3"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8"
                                  Margin="0,8,0,0"
                                  IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}">

                                <!-- Gray until paid AND washed, then turns green -->
                                <Button Grid.Column="0"
                                        Text="Complete"
                                        Style="{StaticResource CompleteButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=CompleteOrderCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <MultiTrigger TargetType="Button">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsPaid}">
                                                    <BindingCondition.Value>
                                                        <sys:Boolean>True</sys:Boolean>
                                                    </BindingCondition.Value>
                                                </BindingCondition>
                                                <BindingCondition Binding="{Binding WashStatus}" Value="Washed" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                                            <Setter Property="TextColor" Value="{StaticResource TextLightColor}" />
                                        </MultiTrigger>
                                    </Button.Triggers>
                                </Button>

                                <Button Grid.Column="1"
                                        Text="Delete"
                                        ImageSource="{StaticResource TrashIcon}"
                                        ContentLayout="Left,4"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="38"
                                        FontSize="13"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>