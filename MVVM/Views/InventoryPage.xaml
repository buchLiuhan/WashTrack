<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WashTrack.MVVM.ViewModels"
             xmlns:models="clr-namespace:WashTrack.Models"
             x:Class="WashTrack.MVVM.Views.InventoryPage"
             x:DataType="vm:InventoryViewModel"
             Title="Inventory">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Add"
                     Command="{Binding AddItemCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               Margin="0,24,0,0" />

            <!-- Active / Inactive toggle -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,0,0,4">
                <Label Grid.Column="0"
                       Text="Track your laundry supplies"
                       Style="{StaticResource MutedLabelStyle}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="{Binding ToggleButtonText}"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="40"
                        Padding="12,0"
                        FontSize="12"
                        Command="{Binding ToggleInactiveCommand}" />
            </Grid>

            <!-- Low stock filter toggle: one button, two states -->
            <Button Text="{Binding LowStockToggleText}"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="36"
                    Padding="12,0"
                    FontSize="12"
                    HorizontalOptions="End"
                    Margin="0,8,0,0"
                    IsVisible="{Binding HasLowStock}"
                    Command="{Binding ToggleLowStockOnlyCommand}" />

            <!-- Stats (active view only) -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8"
                  Margin="0,8,0,0"
                  IsVisible="{Binding ShowingInactive,
                      Converter={StaticResource InverseBoolConverter}}">

                <Border Grid.Column="0"
                        Style="{StaticResource DarkCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding TotalItems}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                        <Label Text="Total Items"
                               FontSize="12"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource DarkCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding LowStockCount}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                        <Label Text="Low Stock"
                               FontSize="12"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Low stock banner. Red, not yellow: this is the one banner on
                 the page that needs acting on, and it sat in the same yellow
                 as the purely informational "showing inactive" notice below.
                 Grid, not HorizontalStackLayout — the latter leaves the label
                 unbounded, so long text was clipped instead of wrapping. -->
            <Border IsVisible="{Binding HasLowStock}"
                    BackgroundColor="#F8D7DA"
                    Stroke="{StaticResource DangerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Image Grid.Column="0"
                           Source="{StaticResource WarningIcon}"
                           WidthRequest="14" HeightRequest="14"
                           VerticalOptions="Start"
                           Margin="0,2,0,0" />
                    <Label Grid.Column="1"
                           Text="{Binding LowStockBannerText}"
                           FontSize="13"
                           TextColor="#721C24"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Inactive banner -->
            <Border IsVisible="{Binding ShowingInactive}"
                    BackgroundColor="#FFF3CD"
                    Stroke="{StaticResource WarningColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Label Text="Showing inactive items. Restore or permanently delete them here."
                       FontSize="12"
                       TextColor="#856404" />
            </Border>

            <Label Text="ALL ITEMS"
                   Style="{StaticResource SectionHeaderLabel}" />

            <CollectionView ItemsSource="{Binding InventoryItems}"
                            IsVisible="{Binding IsLoading,
                                Converter={StaticResource InverseBoolConverter}}">

                <CollectionView.EmptyView>
                    <Label Text="No inventory items. Tap + Add to create one."
                           Style="{StaticResource EmptyStateLabel}"
                           Margin="0,24,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InventoryWithUsage">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,4">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto">

                                <!-- Name -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Item.ItemName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimaryColor}"
                                       VerticalOptions="Center" />

                                <!-- Icon-only edit, top-right — occasional action
                                     (fix name/threshold). Matches the icon
                                     buttons on TransactionsPage. -->
                                <ImageButton Grid.Row="0" Grid.Column="1"
                                             Source="{StaticResource EditIcon}"
                                             Aspect="AspectFit"
                                             WidthRequest="32"
                                             HeightRequest="28"
                                             MinimumWidthRequest="32"
                                             MinimumHeightRequest="28"
                                             Padding="6"
                                             BorderWidth="0"
                                             BackgroundColor="Transparent"
                                             VerticalOptions="Start"
                                             SemanticProperties.Description="Edit item"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=EditItemCommand}"
                                             CommandParameter="{Binding .}"
                                             IsVisible="{Binding Item.IsActive}" />

                                <!-- Stock + unit, own row -->
                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding StockText}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentColor}"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center" />

                                <!-- Low stock pill -->
                                <Border Grid.Row="2" Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource PillDanger}"
                                        HorizontalOptions="Start"
                                        Margin="0,4,0,0"
                                        IsVisible="{Binding Item.IsLowStock}">
                                    <!-- No icon: the red warning SVG was invisible
                                         against PillDanger's red background, and
                                         the word "Low Stock" already carries it. -->
                                    <Label Text="Low Stock"
                                           Style="{StaticResource PillLabelStyle}" />
                                </Border>

                                <!-- Usage forecast -->
                                <Label Grid.Row="3" Grid.ColumnSpan="2"
                                       Text="{Binding ForecastText}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       FontSize="12"
                                       Margin="0,6,0,0" />

                                <!-- Last updated: own full-width row so it never
                                     has to share space with the buttons below. -->
                                <Label Grid.Row="4" Grid.ColumnSpan="2"
                                       Text="{Binding Item.UpdatedAt, StringFormat='Updated: {0:MMM dd, yyyy}'}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       Margin="0,8,0,0" />

                                <!-- Active: Restock + Deactivate -->
                                <Grid Grid.Row="5" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="8"
                                      Margin="0,8,0,0"
                                      IsVisible="{Binding Item.IsActive}">
                                    <Button Grid.Column="0"
                                            Text="Restock"
                                            Style="{StaticResource AccentButton}"
                                            HeightRequest="36"
                                            Padding="10,0"
                                            FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=RestockItemCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="1"
                                            Text="Deactivate"
                                            Style="{StaticResource DangerButton}"
                                            HeightRequest="36"
                                            Padding="10,0"
                                            FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=DeactivateItemCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <!-- Inactive: Restore + Delete -->
                                <Grid Grid.Row="5" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="8"
                                      Margin="0,8,0,0"
                                      IsVisible="{Binding Item.IsActive, Converter={StaticResource InverseBoolConverter}}">
                                    <Button Grid.Column="0"
                                            Text="Restore"
                                            ImageSource="{StaticResource RestoreIcon}"
                                            ContentLayout="Left,4"
                                            Style="{StaticResource AccentButton}"
                                            HeightRequest="36"
                                            Padding="10,0"
                                            FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=RestoreItemCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="1"
                                            Text="Delete"
                                            ImageSource="{StaticResource TrashIcon}"
                                            ContentLayout="Left,4"
                                            Style="{StaticResource DangerButton}"
                                            HeightRequest="36"
                                            Padding="10,0"
                                            FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=PermanentDeleteItemCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>