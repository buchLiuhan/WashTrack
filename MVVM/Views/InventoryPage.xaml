<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WashTrack.MVVM.ViewModels"
             xmlns:models="clr-namespace:WashTrack.Models"
             x:Class="WashTrack.MVVM.Views.InventoryPage"
             x:DataType="vm:InventoryViewModel"
             Title="Inventory">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Add"
                     Command="{Binding AddItemCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               Margin="0,24,0,0" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8"
                  Margin="0,8,0,0"
                  IsVisible="{Binding IsLoading,
                      Converter={StaticResource InverseBoolConverter}}">

                <Border Grid.Column="0"
                        Style="{StaticResource DarkCardStyle}">
                    <StackLayout Spacing="4">
                        <Label Text="{Binding TotalItems}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                        <Label Text="Total Items"
                               FontSize="12"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource DarkCardStyle}">
                    <StackLayout Spacing="4">
                        <Label Text="{Binding LowStockCount}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                        <Label Text="Low Stock"
                               FontSize="12"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Border>
            </Grid>

            <Border IsVisible="{Binding HasLowStock}"
                    BackgroundColor="#FFF3CD"
                    Stroke="#F39C12"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Label Text="⚠️ Some items are running low. Please restock soon."
                       FontSize="13"
                       TextColor="#856404" />
            </Border>

            <Label Text="ALL ITEMS"
                   Style="{StaticResource SectionHeaderLabel}" />

            <CollectionView ItemsSource="{Binding InventoryItems}"
                            IsVisible="{Binding IsLoading,
                                Converter={StaticResource InverseBoolConverter}}">

                <CollectionView.EmptyView>
                    <Label Text="No inventory items. Tap + Add to create one."
                           Style="{StaticResource EmptyStateLabel}"
                           Margin="0,24,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Inventory">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,4">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding ItemName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimaryColor}" />

                                <StackLayout Grid.Row="0" Grid.Column="1"
                                             Spacing="0"
                                             HorizontalOptions="End">
                                    <Label Text="{Binding CurrentStock, StringFormat='{0:F0}'}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource AccentColor}"
                                           HorizontalOptions="End" />
                                    <Label Text="{Binding Unit}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           HorizontalOptions="End" />
                                </StackLayout>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding UpdatedAt, StringFormat='Updated: {0:MMM dd, yyyy}'}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       Margin="0,4,0,0" />

                                <StackLayout Grid.Row="1" Grid.Column="1"
                                             Orientation="Horizontal"
                                             Spacing="8"
                                             HorizontalOptions="End"
                                             Margin="0,4,0,0">
                                    <Button Text="Edit"
                                            Style="{StaticResource AccentButton}"
                                            HeightRequest="32"
                                            Padding="10,0"
                                            FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=EditItemCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="Delete"
                                            Style="{StaticResource DangerButton}"
                                            HeightRequest="32"
                                            Padding="10,0"
                                            FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=DeleteItemCommand}"
                                            CommandParameter="{Binding .}" />
                                </StackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>