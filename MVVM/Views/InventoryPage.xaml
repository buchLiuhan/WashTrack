<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WashTrack.MVVM.ViewModels"
             xmlns:models="clr-namespace:WashTrack.Models"
             x:Class="WashTrack.MVVM.Views.InventoryPage"
             x:DataType="vm:InventoryViewModel"
             Title="Inventory">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Add"
                     Command="{Binding AddItemCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               Margin="0,24,0,0" />

            <!-- Active / Inactive toggle -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,0,0,4">
                <Label Grid.Column="0"
                       Text="Track your laundry supplies"
                       Style="{StaticResource MutedLabelStyle}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="{Binding ToggleButtonText}"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="40"
                        Padding="12,0"
                        FontSize="12"
                        Command="{Binding ToggleInactiveCommand}" />
            </Grid>

            <!-- Stats (active view only) -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8"
                  Margin="0,8,0,0"
                  IsVisible="{Binding ShowingInactive,
                      Converter={StaticResource InverseBoolConverter}}">

                <Border Grid.Column="0"
                        Style="{StaticResource DarkCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding TotalItems}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                        <Label Text="Total Items"
                               FontSize="12"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource DarkCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding LowStockCount}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                        <Label Text="Low Stock"
                               FontSize="12"
                               TextColor="{StaticResource TextLightColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Low stock banner -->
            <Border IsVisible="{Binding HasLowStock}"
                    BackgroundColor="#FFF3CD"
                    Stroke="{StaticResource WarningColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Label Text="⚠️ Some items are running low. Please restock soon."
                       FontSize="13"
                       TextColor="#856404" />
            </Border>

            <!-- Inactive banner -->
            <Border IsVisible="{Binding ShowingInactive}"
                    BackgroundColor="#FFF3CD"
                    Stroke="{StaticResource WarningColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Label Text="Showing inactive items. Restore or permanently delete them here."
                       FontSize="12"
                       TextColor="#856404" />
            </Border>

            <Label Text="ALL ITEMS"
                   Style="{StaticResource SectionHeaderLabel}" />

            <CollectionView ItemsSource="{Binding InventoryItems}"
                            IsVisible="{Binding IsLoading,
                                Converter={StaticResource InverseBoolConverter}}">

                <CollectionView.EmptyView>
                    <Label Text="No inventory items. Tap + Add to create one."
                           Style="{StaticResource EmptyStateLabel}"
                           Margin="0,24,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Inventory">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,4">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto,Auto">

                                <!-- Name -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding ItemName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimaryColor}"
                                       VerticalOptions="Center" />

                                <!-- Stock + unit -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding CurrentStock, StringFormat='{0:F0}'}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentColor}"
                                       HorizontalOptions="End" />

                                <Label Grid.Row="1" Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Unit}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalOptions="End" />

                                <!-- Low stock pill: shows WHICH item is low -->
                                <Border Grid.Row="1" Grid.Column="0"
                                        Style="{StaticResource PillDanger}"
                                        HorizontalOptions="Start"
                                        Margin="0,4,0,0"
                                        IsVisible="{Binding IsLowStock}">
                                    <Label Text="Low Stock"
                                           Style="{StaticResource PillLabelStyle}" />
                                </Border>

                                <!-- Last updated -->
                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding UpdatedAt, StringFormat='Updated: {0:MMM dd, yyyy}'}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       Margin="0,8,0,0"
                                       VerticalOptions="Center" />

                                <!-- Active: Edit -->
                                <Button Grid.Row="2" Grid.Column="1"
                                        Text="Edit"
                                        Style="{StaticResource AccentButton}"
                                        HeightRequest="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,8,8,0"
                                        IsVisible="{Binding IsActive}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=EditItemCommand}"
                                        CommandParameter="{Binding .}" />

                                <!-- Active: Deactivate -->
                                <Button Grid.Row="2" Grid.Column="2"
                                        Text="Deactivate"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding IsActive}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=DeactivateItemCommand}"
                                        CommandParameter="{Binding .}" />

                                <!-- Inactive: Restore -->
                                <Button Grid.Row="2" Grid.Column="1"
                                        Text="Restore"
                                        Style="{StaticResource AccentButton}"
                                        HeightRequest="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,8,8,0"
                                        IsVisible="{Binding IsActive, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=RestoreItemCommand}"
                                        CommandParameter="{Binding .}" />

                                <!-- Inactive: Permanent delete -->
                                <Button Grid.Row="2" Grid.Column="2"
                                        Text="Delete"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding IsActive, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=PermanentDeleteItemCommand}"
                                        CommandParameter="{Binding .}" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>