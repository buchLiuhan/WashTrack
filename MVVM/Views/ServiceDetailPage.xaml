<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WashTrack.MVVM.ViewModels"
             x:Class="WashTrack.MVVM.Views.ServiceDetailPage"
             x:DataType="vm:ServiceDetailViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="4">

            <Label Text="SERVICE DETAILS"
                   Style="{StaticResource SectionHeaderLabel}" />

            <Label Text="Service Name"
                   Style="{StaticResource FieldLabelStyle}" />
            <Entry Placeholder="e.g. Wash and Fold"
                   Text="{Binding ServiceName}" />

            <Label Text="Pricing Type"
                   Style="{StaticResource FieldLabelStyle}" />
            <Grid ColumnDefinitions="*,Auto"
                  BackgroundColor="{StaticResource InputBackgroundColor}"
                  HeightRequest="48">
                <Picker Grid.Column="0"
                        ItemsSource="{Binding PricingModes}"
                        SelectedItem="{Binding SelectedPricingMode}"
                        TextColor="{StaticResource TextPrimaryColor}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        Margin="12,0,0,0" />
                <Label Grid.Column="1"
                       Text="▼"
                       TextColor="{StaticResource TextMutedColor}"
                       VerticalOptions="Center"
                       Margin="0,0,12,0" />
            </Grid>

            <!-- Mode A: Per Kilo -->
            <VerticalStackLayout IsVisible="{Binding IsPerKiloMode}">
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,16,0,8" />
                <Label Text="PER KILO" Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Price per Kilo (₱)" Style="{StaticResource FieldLabelStyle}" />
                <Entry Placeholder="e.g. 30"
                       Text="{Binding PricePerKilo}"
                       Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Mode B: Minimum Charge -->
            <VerticalStackLayout IsVisible="{Binding IsMinChargeMode}">
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,16,0,8" />
                <Label Text="MINIMUM CHARGE" Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Minimum Weight (kg)" Style="{StaticResource FieldLabelStyle}" />
                <Entry Placeholder="e.g. 3"
                       Text="{Binding MinKilo}"
                       Keyboard="Numeric" />
                <Label Text="Minimum Charge (₱)" Style="{StaticResource FieldLabelStyle}" />
                <Entry Placeholder="e.g. 200"
                       Text="{Binding MinKiloCharge}"
                       Keyboard="Numeric" />
                <Label Text="Excess per Kilo — optional (₱)" Style="{StaticResource FieldLabelStyle}" />
                <Entry Placeholder="e.g. 50 (leave blank if none)"
                       Text="{Binding ExcessPerKilo}"
                       Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Mode C: Flat Rate -->
            <VerticalStackLayout IsVisible="{Binding IsFlatRateMode}">
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,16,0,8" />
                <Label Text="FLAT RATE (PER PIECE / LOAD)" Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Price per Piece/Load (₱)" Style="{StaticResource FieldLabelStyle}" />
                <Entry Placeholder="e.g. 300"
                       Text="{Binding FlatRate}"
                       Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- ===== SUPPLY USAGE ===== -->
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,16,0,8" />
            <Label Text="SUPPLY USAGE" Style="{StaticResource SectionHeaderLabel}" />
            <Label Text="{Binding UsageHelpText}"
                   Style="{StaticResource MutedLabelStyle}"
                   FontSize="12" />
            <Label Text="Leave a slot empty if this service doesn't use it."
                   Style="{StaticResource MutedLabelStyle}"
                   FontSize="12"
                   Margin="0,0,0,8" />

            <!-- No inventory yet -->
            <Border IsVisible="{Binding HasInventoryItems, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="{StaticResource InputBackgroundColor}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <Grid RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0"
                           Text="No inventory items yet."
                           FontSize="13"
                           TextColor="{StaticResource TextMutedColor}" />
                    <Label Grid.Row="1"
                           Text="Add one in Inventory →"
                           TextColor="{StaticResource AccentColor}"
                           FontAttributes="Bold"
                           FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToInventoryCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <VerticalStackLayout IsVisible="{Binding HasInventoryItems}">

                <!-- Detergent slot -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Detergent"
                           Style="{StaticResource FieldLabelStyle}" />
                    <Label Grid.Column="1"
                           Text="✕ Clear"
                           TextColor="{StaticResource DangerColor}"
                           FontSize="12"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasDetergentSelection}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearDetergentCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label Text="The soap used for washing."
                       Style="{StaticResource MutedLabelStyle}"
                       FontSize="12" />
                <Grid ColumnDefinitions="*,Auto"
                      BackgroundColor="{StaticResource InputBackgroundColor}">
                    <Picker Grid.Column="0"
                            ItemsSource="{Binding AvailableItems}"
                            SelectedItem="{Binding SelectedDetergentItem}"
                            ItemDisplayBinding="{Binding ItemName}"
                            Title="Select item"
                            TextColor="{StaticResource TextPrimaryColor}"
                            BackgroundColor="Transparent"
                            TitleColor="{StaticResource TextMutedColor}" />
                    <Label Grid.Column="1"
                           Text="▼"
                           TextColor="{StaticResource TextMutedColor}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0" />
                </Grid>
                <Entry Placeholder="e.g. 20"
                       Text="{Binding DetergentUsage}"
                       Keyboard="Numeric"
                       IsVisible="{Binding HasDetergentSelection}"
                       Margin="0,4,0,0" />
                <Label Text="{Binding UsageUnitLabel}"
                       Style="{StaticResource MutedLabelStyle}"
                       FontSize="12"
                       IsVisible="{Binding HasDetergentSelection}"
                       Margin="0,2,0,8" />

                <!-- Fabric Conditioner slot -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Fabric Conditioner"
                           Style="{StaticResource FieldLabelStyle}" />
                    <Label Grid.Column="1"
                           Text="✕ Clear"
                           TextColor="{StaticResource DangerColor}"
                           FontSize="12"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasConditionerSelection}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearConditionerCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label Text="The softener used per wash."
                       Style="{StaticResource MutedLabelStyle}"
                       FontSize="12" />
                <Grid ColumnDefinitions="*,Auto"
                      BackgroundColor="{StaticResource InputBackgroundColor}">
                    <Picker Grid.Column="0"
                            ItemsSource="{Binding AvailableItems}"
                            SelectedItem="{Binding SelectedConditionerItem}"
                            ItemDisplayBinding="{Binding ItemName}"
                            Title="Select item"
                            TextColor="{StaticResource TextPrimaryColor}"
                            BackgroundColor="Transparent"
                            TitleColor="{StaticResource TextMutedColor}" />
                    <Label Grid.Column="1"
                           Text="▼"
                           TextColor="{StaticResource TextMutedColor}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0" />
                </Grid>
                <Entry Placeholder="e.g. 20"
                       Text="{Binding ConditionerUsage}"
                       Keyboard="Numeric"
                       IsVisible="{Binding HasConditionerSelection}"
                       Margin="0,4,0,0" />
                <Label Text="{Binding UsageUnitLabel}"
                       Style="{StaticResource MutedLabelStyle}"
                       FontSize="12"
                       IsVisible="{Binding HasConditionerSelection}"
                       Margin="0,2,0,8" />

                <!-- Other supply slot -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Other Supply"
                           Style="{StaticResource FieldLabelStyle}" />
                    <Label Grid.Column="1"
                           Text="✕ Clear"
                           TextColor="{StaticResource DangerColor}"
                           FontSize="12"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasOtherSelection}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearOtherCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label Text="Any other consumable, e.g. bleach or stain remover."
                       Style="{StaticResource MutedLabelStyle}"
                       FontSize="12" />
                <Grid ColumnDefinitions="*,Auto"
                      BackgroundColor="{StaticResource InputBackgroundColor}">
                    <Picker Grid.Column="0"
                            ItemsSource="{Binding AvailableItems}"
                            SelectedItem="{Binding SelectedOtherItem}"
                            ItemDisplayBinding="{Binding ItemName}"
                            Title="Select item"
                            TextColor="{StaticResource TextPrimaryColor}"
                            BackgroundColor="Transparent"
                            TitleColor="{StaticResource TextMutedColor}" />
                    <Label Grid.Column="1"
                           Text="▼"
                           TextColor="{StaticResource TextMutedColor}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0" />
                </Grid>
                <Entry Placeholder="e.g. 5"
                       Text="{Binding OtherUsage}"
                       Keyboard="Numeric"
                       IsVisible="{Binding HasOtherSelection}"
                       Margin="0,4,0,0" />
                <Label Text="{Binding UsageUnitLabel}"
                       Style="{StaticResource MutedLabelStyle}"
                       FontSize="12"
                       IsVisible="{Binding HasOtherSelection}"
                       Margin="0,2,0,8" />

            </VerticalStackLayout>

            <Button Text="Save Service"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    Margin="0,24,0,8" />
            <Button Text="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>