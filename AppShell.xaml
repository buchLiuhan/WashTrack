<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WashTrack.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:WashTrack.MVVM.Views"
    >

    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate views:DashboardPage}"
        Route="DashboardPage" />

    <ShellContent
        Title="Services"
        ContentTemplate="{DataTemplate views:ServicesPage}"
        Route="ServicesPage" />

    <ShellContent
        Title="Transactions"
        ContentTemplate="{DataTemplate views:TransactionsPage}"
        Route="TransactionsPage" />

    
    <ShellContent
        Title="Customers"
        ContentTemplate="{DataTemplate views:CustomersPage}"
        Route="CustomersPage" />
    
   
    <ShellContent
        Title="Inventory"
        ContentTemplate="{DataTemplate views:InventoryPage}"
        Route="InventoryPage" />

    <ShellContent
        Title="Reports"
        ContentTemplate="{DataTemplate views:ReportsPage}"
        Route="ReportsPage" />

    <!-- Logout lives in the flyout footer rather than on the Dashboard so it
         is reachable from every page, which is where the owner will actually
         be when she finishes for the day. Red on the flyout's light
         background — the only red item here, so it reads as "different"
         without competing with anything. -->
    <Shell.FlyoutFooter>
        <Grid Padding="20,16" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLogoutTapped" />
            </Grid.GestureRecognizers>
            <Image Grid.Column="0"
                   Source="{StaticResource LogoutIcon}"
                   WidthRequest="18" HeightRequest="18"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="Log out"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource DangerColor}"
                   VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutFooter>

</Shell>